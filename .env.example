# ExecLens runtime configuration.
# No credentials or secrets are required: all market data is synthetic.
# Copy to `.env` (git-ignored) to override defaults, e.g. for docker compose.

# Dataset served by the API/dashboard (a directory produced by `execlens generate`).
EXECLENS_DATA_DIR=data/sample

# A quote older than this (seconds) is treated as stale market context.
EXECLENS_STALE_QUOTE_TOLERANCE_SECONDS=30

# Machine-readable benchmark results displayed by the dashboard.
EXECLENS_BENCHMARK_RESULTS=benchmarks/results.json
